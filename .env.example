# ============================================================
#  Travel Planning Agent — backend environment variables
#  Copy to .env and fill in the keys you have. Anything left
#  blank simply degrades to the deterministic mock provider.
# ============================================================

# ===== LLM =====
# Default mock so the demo runs with no key. Flip to false when you
# want to call GPT-4o for real.
MOCK_LLM=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
# Optional self-hosted / proxy base URL (e.g. for an OpenAI-compatible gateway).
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ===== External data sources =====
# Master switch. Set to false to use the real provider stack below;
# anything missing a key still degrades to mock for that tool only.
USE_MOCK_TOOLS=true

# --- Weather ---
# QWeather (和风天气) — domestic China. https://dev.qweather.com/
# Apply: register → 控制台 → 项目管理 → 创建项目 → 添加 KEY (Web API 类型).
# Free tier: 1000 req/day.
QWEATHER_API_KEY=
# IMPORTANT: since late-2024 QWeather assigns each developer a *dedicated*
# API host. The legacy shared host `devapi.qweather.com` returns 403 for new
# accounts. Copy the "API Host" line shown on your project page in the
# console (https://console.qweather.com/), e.g.
#     QWEATHER_API_HOST=https://abcd1234ef.re.qweatherapi.com
# Pro/standard plans use the same dedicated-host scheme.
QWEATHER_API_HOST=

# OpenWeatherMap — overseas. https://openweathermap.org/api
# Apply: register → API keys tab → Generate. Free tier 60 req/min, 1M req/month;
# the 5-day / 3-hour /forecast endpoint is free. Newly issued keys can take ~1–2h
# to activate.
OPENWEATHER_API_KEY=

# --- Flights & Hotels (Amadeus Self-Service, both global) ---
# https://developers.amadeus.com/self-service
# Apply: sign up → My Self-Service Workspace → Create new app → copy
# API Key (client_id) and API Secret (client_secret). Free Test env quota
# is 2000 calls / month.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Test env (free):       https://test.api.amadeus.com  (default)
# Production env (paid): https://api.amadeus.com
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- POI (Amap, domestic-China focused) ---
# 高德开放平台. https://lbs.amap.com/
# Apply: register → 控制台 → 应用管理 → 创建新应用 → 添加 Key (服务平台 = Web 服务).
# Personal dev tier: 30万次/天.
AMAP_API_KEY=

# ===== Service =====
HOST=0.0.0.0
PORT=8000
ALLOW_ORIGINS=*
LOG_LEVEL=INFO
