# ===== LLM =====
# Set MOCK_LLM=true to run the demo with deterministic stub responses (no API key needed).
# Set MOCK_LLM=false and provide OPENAI_API_KEY to use real GPT-4o.
MOCK_LLM=true

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=

LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=

LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ===== Tools data sources =====
# true = use mock providers (default for demo)
USE_MOCK_TOOLS=true

# ===== Server =====
HOST=0.0.0.0
PORT=8000
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ===== Real API keys (only used when USE_MOCK_TOOLS=false) =====
AMAP_KEY=
QWEATHER_KEY=
OWM_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
TRIPADVISOR_KEY=
BOOKING_AFFILIATE_ID=
